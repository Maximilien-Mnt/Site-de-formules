---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/index';
import { DEFAULT_LANG } from '@/i18n/config';
import Button from '@/components/ui/Button.astro';
import Chip from '@/components/ui/Chip.astro';
import LevelDots from '@/components/ui/LevelDots.astro';
import DifficultyMark from '@/components/ui/DifficultyMark.astro';
import Callout from '@/components/ui/Callout.astro';
import Card from '@/components/ui/Card.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import FormulaDisplay from '@/components/math/FormulaDisplay.astro';

const lang = DEFAULT_LANG;
const sampleLatex = 'a^2 + b^2 = c^2';
---
<BaseLayout lang={lang} title={t(lang, "design.title")} description={t(lang, "design.subtitle")}>
  <main id="main-content" class="max-w-[var(--w-content)] mx-auto px-4 py-10">
    <h1 class="font-serif text-4xl font-semibold tracking-tight text-text mb-2">
      {t(lang, "design.title")}
    </h1>
    <p class="text-muted text-md mb-10 max-w-prose">{t(lang, "design.subtitle")}</p>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.button")}</h2>
    <div class="flex flex-wrap gap-4 mb-10">
      <Button variant="primary" size="sm">{t(lang, "design.size.sm")}</Button>
      <Button variant="primary" size="md">{t(lang, "design.size.md")}</Button>
      <Button variant="primary" size="lg">{t(lang, "design.size.lg")}</Button>
      <Button variant="secondary">{t(lang, "design.state.secondary")}</Button>
      <Button variant="quiet">{t(lang, "design.state.quiet")}</Button>
      <Button variant="primary" disabled>{t(lang, "design.state.disabled")}</Button>
      <Button variant="primary" loading>{t(lang, "design.state.loading")}</Button>
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.chip")}</h2>
    <div class="flex flex-wrap gap-4 mb-10">
      <Chip label={t(lang, "design.state.default")} />
      <Chip label={t(lang, "design.state.selected")} selected />
      <Chip label="Géométrie" />
      <Chip label="Niveau 3" selected />
    </div>
    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.level")}</h2>
    <div class="flex flex-wrap gap-8 items-center mb-10">
      <div class="flex flex-col items-center gap-2">
        <LevelDots level={1} lang={lang} />
        <p class="text-xs text-muted">{t(lang, "level.1")}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <LevelDots level={3} lang={lang} />
        <p class="text-xs text-muted">{t(lang, "level.3")}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <LevelDots level={7} lang={lang} />
        <p class="text-xs text-muted">{t(lang, "level.7")}</p>
      </div>
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.difficulty")}</h2>
    <div class="flex flex-wrap gap-8 items-center mb-10">
      <div class="flex flex-col items-center gap-2">
        <DifficultyMark difficulty={1} lang={lang} />
        <p class="text-xs text-muted">{t(lang, "difficulty.1")}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <DifficultyMark difficulty={3} lang={lang} />
        <p class="text-xs text-muted">{t(lang, "difficulty.3")}</p>
      </div>
      <div class="flex flex-col items-center gap-2">
        <DifficultyMark difficulty={5} lang={lang} />
        <p class="text-xs text-muted">{t(lang, "difficulty.5")}</p>
      </div>
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.callout")}</h2>
    <div class="flex flex-col gap-4 mb-10">
      <Callout type="tip" lang={lang}>Ceci est une astuce.</Callout>
      <Callout type="warning" lang={lang}>Ceci est un avertissement.</Callout>
      <Callout type="note" lang={lang}>Ceci est une note.</Callout>
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.card")}</h2>
    <div class="flex flex-wrap gap-6 mb-10">
      <Card class="w-64"><p class="text-text">{t(lang, "design.state.default")}</p></Card>
      <Card variant="interactive" class="w-64"><p class="text-text">{t(lang, "design.state.default")}</p></Card>
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.breadcrumb")}</h2>
    <div class="mb-10">
      <Breadcrumb
        lang={lang}
        items={[
          { label: t(lang, "nav.formulas"), href: "/fr/formules/" },
          { label: "Géométrie", href: "/fr/formules/" },
          { label: "Théorème de Pythagore" },
        ]}
      />
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.empty")}</h2>
    <div class="mb-10">
      <EmptyState
        lang={lang}
        title={t(lang, "empty.title")}
        hint={t(lang, "empty.hint")}
        action={{ label: t(lang, "common.seeAll"), href: "/fr/formules/" }}
      />
    </div>

    <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.math")}</h2>
    <div class="mb-10 max-w-xl">
      <FormulaDisplay latex={sampleLatex} lang={lang} />
    </div>
    <section data-theme="dark" class="mt-16 rounded-lg border border-border bg-surface p-10">
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">Mode sombre</h2>
      <p class="text-muted text-md mb-10 max-w-prose">Même galerie, thème sombre.</p>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-text mb-2">
        {t(lang, "design.title")}
      </h1>
      <p class="text-muted text-md mb-10 max-w-prose">{t(lang, "design.subtitle")}</p>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.button")}</h2>
      <div class="flex flex-wrap gap-4 mb-10">
        <Button variant="primary" size="sm">{t(lang, "design.size.sm")}</Button>
        <Button variant="primary" size="md">{t(lang, "design.size.md")}</Button>
        <Button variant="primary" size="lg">{t(lang, "design.size.lg")}</Button>
        <Button variant="secondary">{t(lang, "design.state.secondary")}</Button>
        <Button variant="quiet">{t(lang, "design.state.quiet")}</Button>
        <Button variant="primary" disabled>{t(lang, "design.state.disabled")}</Button>
        <Button variant="primary" loading>{t(lang, "design.state.loading")}</Button>
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.chip")}</h2>
      <div class="flex flex-wrap gap-4 mb-10">
        <Chip label={t(lang, "design.state.default")} />
        <Chip label={t(lang, "design.state.selected")} selected />
        <Chip label="Géométrie" />
        <Chip label="Niveau 3" selected />
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.level")}</h2>
      <div class="flex flex-wrap gap-8 items-center mb-10">
        <div class="flex flex-col items-center gap-2">
          <LevelDots level={1} lang={lang} />
          <p class="text-xs text-muted">{t(lang, "level.1")}</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <LevelDots level={3} lang={lang} />
          <p class="text-xs text-muted">{t(lang, "level.3")}</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <LevelDots level={7} lang={lang} />
          <p class="text-xs text-muted">{t(lang, "level.7")}</p>
        </div>
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.difficulty")}</h2>
      <div class="flex flex-wrap gap-8 items-center mb-10">
        <div class="flex flex-col items-center gap-2">
          <DifficultyMark difficulty={1} lang={lang} />
          <p class="text-xs text-muted">{t(lang, "difficulty.1")}</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <DifficultyMark difficulty={3} lang={lang} />
          <p class="text-xs text-muted">{t(lang, "difficulty.3")}</p>
        </div>
        <div class="flex flex-col items-center gap-2">
          <DifficultyMark difficulty={5} lang={lang} />
          <p class="text-xs text-muted">{t(lang, "difficulty.5")}</p>
        </div>
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.callout")}</h2>
      <div class="flex flex-col gap-4 mb-10">
        <Callout type="tip" lang={lang}>Ceci est une astuce.</Callout>
        <Callout type="warning" lang={lang}>Ceci est un avertissement.</Callout>
        <Callout type="note" lang={lang}>Ceci est une note.</Callout>
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.card")}</h2>
      <div class="flex flex-wrap gap-6 mb-10">
        <Card class="w-64"><p class="text-text">{t(lang, "design.state.default")}</p></Card>
        <Card variant="interactive" class="w-64"><p class="text-text">{t(lang, "design.state.default")}</p></Card>
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.breadcrumb")}</h2>
      <div class="mb-10">
        <Breadcrumb
          lang={lang}
          items={[
            { label: t(lang, "nav.formulas"), href: "/fr/formules/" },
            { label: "Géométrie", href: "/fr/formules/" },
            { label: "Théorème de Pythagore" },
          ]}
        />
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.empty")}</h2>
      <div class="mb-10">
        <EmptyState
          lang={lang}
          title={t(lang, "empty.title")}
          hint={t(lang, "empty.hint")}
          action={{ label: t(lang, "common.seeAll"), href: "/fr/formules/" }}
        />
      </div>
      <h2 class="font-serif text-2xl font-semibold text-text mb-6">{t(lang, "design.group.math")}</h2>
      <div class="mb-10 max-w-xl">
        <FormulaDisplay latex={sampleLatex} lang={lang} />
      </div>
    </section>
  </main>
</BaseLayout>