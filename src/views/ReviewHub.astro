---
import { localizedPath, DEFAULT_LANG, type Lang } from '@/i18n/config'
import { t } from '@/i18n/index'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ReviewHubApp from '@/components/islands/ReviewHubApp.tsx'

interface Props {
  lang?: Lang
}

const { lang = DEFAULT_LANG } = Astro.props
---

<BaseLayout lang={lang} title={t(lang, 'review.title')}>
  <ReviewHubApp
    client:visible
    lang={lang}
    sessionUrl={localizedPath(lang, 'reviewFlashcards')}
    quizUrl={localizedPath(lang, 'reviewQuiz')}
    catalogUrl={localizedPath(lang, 'formulas')}
  />
</BaseLayout>