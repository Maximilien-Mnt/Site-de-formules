---
import { getFormulas } from '@/lib/content'
import { localizedPath, DEFAULT_LANG, type Lang } from '@/i18n/config'
import { t, type TranslationKey } from '@/i18n/index'
import { buildSummaryItems, groupByDomain, type FormulaSummaryItem } from '@/lib/summary'
import BaseLayout from '@/layouts/BaseLayout.astro'
import FormulaSummaryApp from '@/components/islands/FormulaSummaryApp.tsx'

export const prerender = true

const { lang = DEFAULT_LANG } = Astro.props

const formulas = getFormulas(lang).filter((f) => f.status === 'published')
const items: FormulaSummaryItem[] = buildSummaryItems(formulas).map((item) => ({
  ...item,
  url: localizedPath(lang, 'formula', { id: item.id }),
}))

const groups = groupByDomain(items, (d) =>
  t(lang, `domain.${d}` as TranslationKey),
)
<BaseLayout lang={lang} title={t(lang, 'summary.title')}>
  <div class="mx-auto w-full max-w-[var(--w-content)] px-4 py-8 lg:py-12">
    <div class="print:hidden">
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-text">
        {t(lang, 'summary.title')}
      </h1>
      <p class="mt-2 text-lg text-muted">{t(lang, 'summary.subtitle')}</p>
    </div>

    <div class="print:hidden mb-8 flex flex-wrap items-center gap-2">
      <button type="button" id="summary-select-all" class="inline-flex items-center justify-center gap-2 rounded-md border border-border-strong bg-surface px-4 py-2 text-base font-medium text-text transition-colors hover:bg-surface-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring focus-visible:ring-offset-2">
        {t(lang, 'summary.selectAll')}
      </button>
      <button type="button" id="summary-select-none" class="inline-flex items-center justify-center gap-2 rounded-md border border-border-strong bg-surface px-4 py-2 text-base font-medium text-text transition-colors hover:bg-surface-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring focus-visible:ring-offset-2">
        {t(lang, 'summary.selectNone')}
      </button>
      <button type="button" id="summary-print" class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-base font-medium text-on-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring focus-visible:ring-offset-2">
        {t(lang, 'summary.print')}
      </button>
    </div>

    <p class="print:hidden mb-6 text-sm text-muted" id="summary-count">
      {t(lang, 'summary.count', { count: items.length })}
    </p>
<div id="summary-grid" class="grid gap-6">
      {groups.map((group) => (
        <section
          class="summary-domain print:break-inside-avoid"
          aria-labelledby={`summary-domain-${group.domain}`}
        >
          <h2
            id={`summary-domain-${group.domain}`}
            class="font-serif text-2xl font-semibold tracking-tight text-text border-b border-border pb-2 mb-4"
          >
            {t(lang, `domain.${group.domain}` as TranslationKey)}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.items.map((item) => (
              <article
                id={`summary-item-${item.id}`}
                class="summary-card summary-selected rounded-lg border border-border bg-surface p-4 break-inside-avoid flex flex-col"
                data-id={item.id}
              >
                <input
                  type="checkbox"
                  class="summary-checkbox sr-only focus-visible:sr-only"
                  checked
                  aria-label={t(lang, 'summary.selectFormula', { title: item.title })}
                />
                <a
                  href={item.url}
                  class="block text-text hover:text-primary transition-colors duration-[var(--dur-fast)]"
                >
                  <h3 class="font-serif text-base font-semibold leading-tight">
                    {item.title}
                  </h3>
                  <div
                    class="mt-2 text-[var(--text-xs)] text-muted"
                    set:html={item.latex}
                  />
                </a>
                {item.variables.length > 0 && (
                  <dl class="mt-3 space-y-1 text-sm">
                    {item.variables.map((v) => (
                      <div key={v.symbol} class="flex items-baseline gap-1">
                        <dt class="min-w-4 shrink-0 text-[var(--text-xs)] text-muted" set:html={v.symbol} />
                        <dd class="text-[var(--text-xs)] text-muted">{v.name}</dd>
                        {v.unit && (
                          <span class="ms-1 text-[var(--text-xs)] text-subtle">
                            ({v.unit})
                          </span>
                        )}
                      </div>
                    ))}
                  </dl>
                )}
                {item.variants.length > 0 && (
                  <section class="mt-3 pt-3 border-t border-border">
                    <h4 class="text-[var(--text-xs)] font-semibold uppercase tracking-wider text-subtle">
                      {t(lang, 'formula.variants')}
                    </h4>
                    <ul class="mt-1 space-y-1 text-sm">
                      {item.variants.map((v) => (
                        <li key={v.id} class="flex items-baseline gap-1">
                          <span class="text-[var(--text-xs)] text-muted" set:html={v.latex} />
                          {v.label && (
                            <span class="text-[var(--text-xs)] text-subtle">
                              â€” {v.label}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
                <div class="mt-4 flex items-center justify-between gap-2">
                  <span
                    class="inline-flex items-center gap-1 rounded-full border border-border-strong bg-surface-2 px-2 py-0.5 text-[var(--text-xs)] font-medium text-text"
                  >
                    {t(lang, `level.${item.level}` as TranslationKey)}
                  </span>
                  <span
                    class="inline-flex items-center gap-1 rounded-full border border-border-strong bg-surface-2 px-2 py-0.5 text-[var(--text-xs)] font-medium text-text"
                  >
                    {t(lang, `difficulty.${item.difficulty}` as TranslationKey)}
                  </span>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
{items.length === 0 && (
      <div class="print:hidden text-center py-12">
        <p class="text-muted">{t(lang, 'summary.noFormulas')}</p>
      </div>
    )}

    <FormulaSummaryApp
      client:visible
      lang={lang}
      itemIds={items.map((i) => i.id)}
    />
  </div>
</BaseLayout>
