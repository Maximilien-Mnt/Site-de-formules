---
import { t } from '@/i18n/index'
import type { Lang } from '@/i18n/config'
import type { SearchFormula } from '@/lib/filters'
import FormulaCard from './FormulaCard.astro'
import EmptyState from './EmptyState.astro'

interface Props {
  lang: Lang
  formulas: SearchFormula[]
  count?: number
}

const { lang, formulas = [], count } = Astro.props
const total = count ?? formulas.length
---
<div class="flex flex-col gap-4">
  <div class="flex items-center justify-between gap-2">
    <span class="text-sm text-muted">
      {total === 0 ? t(lang, 'catalog.empty.title') : t(lang, 'common.results.other', { count: total })}
    </span>
  </div>

  {total === 0 ? (
    <EmptyState
      lang={lang}
      title={t(lang, 'catalog.empty.title')}
      hint={t(lang, 'catalog.empty.hint')}
    />
  ) : (
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
      role="list"
      aria-label={t(lang, 'common.results.other', { count: total })}
    >
      {formulas.map((formula) => (
        <li key={formula.id}>
          <FormulaCard lang={lang} formula={formula} />
        </li>
      ))}
    </ul>
  )}
</div>