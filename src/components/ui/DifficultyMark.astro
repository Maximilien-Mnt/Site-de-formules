---
import { t } from '@/i18n/index';
import type { Lang } from '@/i18n/config';

interface Props {
  lang?: Lang;
  difficulty: number;
  size?: 'sm' | 'md';
}

const { lang = 'fr', difficulty = 1, size = 'md' } = Astro.props;
const mark = size === 'sm' ? 'w-2 h-2' : 'w-2.5 h-2.5';
---

<div
  class="flex gap-1"
  role="img"
  aria-label={t(lang, 'difficulty.label') + ' : ' + t(lang, `difficulty.${difficulty}` as import('@/i18n/index').TranslationKey)}
>
  {[1, 2, 3, 4, 5].map((i) => (
    <span
      class={`${mark} rotate-45 ${i <= difficulty ? 'bg-primary' : 'border border-border-strong bg-transparent'}`}
      aria-hidden="true"
    />
  ))}
</div>