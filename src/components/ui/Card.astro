---
interface Props {
  variant?: 'default' | 'interactive';
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

const { variant = 'default', padding = 'md' } = Astro.props;

const p: Record<string, string> = { none: '', sm: 'p-4', md: 'p-5', lg: 'p-8' };
---

<div
  class={`rounded-md border border-border bg-surface ${p[padding]} ${
    variant === 'interactive'
      ? 'hover:border-border-strong hover:shadow-sm transition-all duration-[var(--dur-fast)] ease-[var(--ease-out)]'
      : ''
  }`}
>
  <slot />
</div>