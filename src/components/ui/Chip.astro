---
import { t } from '@/i18n/index';
import type { Lang } from '@/i18n/config';

interface Props {
  lang?: Lang;
  label?: string;
  selected?: boolean;
  href?: string;
  type?: 'button' | 'reset';
}

const { lang = 'fr', label, selected = false, href, type = 'button' } = Astro.props;
const isLink = !!href;

const base =
  'inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-sans font-medium text-text transition-colors duration-[var(--dur-fast)] ease-[var(--ease-out)]';
const selectedCls = `${base} border-primary bg-primary-soft text-primary`;
const unselectedCls = `${base} border-border bg-surface hover:bg-surface-2`;
---

{isLink ? (
  <a href={href} class={selected ? selectedCls : unselectedCls} aria-current={selected || undefined}>
    {selected && <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>}
    <span>{label}</span>
  </a>
) : (
  <button type={type} class={selected ? selectedCls : unselectedCls} aria-pressed={selected}>
    {selected && <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>}
    <span>{label}</span>
  </button>
)}