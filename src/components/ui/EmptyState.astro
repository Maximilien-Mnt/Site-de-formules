---
import Button from './Button.astro';
import { t } from '@/i18n/index';
import type { Lang } from '@/i18n/config';

interface Props {
  lang?: Lang;
  title: string;
  hint: string;
  action?: { label: string; href: string };
}

const { lang = 'fr', title, hint, action } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-4 p-10 text-center rounded-lg border border-border bg-surface-2">
  <svg class="w-16 h-16 text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M9 11h6m-6 4h6m2-5H9" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <h3 class="font-serif text-xl font-semibold text-text">{title}</h3>
  <p class="text-muted max-w-xs">{hint}</p>
  {action && (
    <Button variant="primary" href={action.href}>{action.label}</Button>
  )}
</div>