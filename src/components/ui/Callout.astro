---
import { t } from '@/i18n/index';
import type { Lang } from '@/i18n/config';

interface Props {
  lang?: Lang;
  type?: 'tip' | 'warning' | 'note';
  title?: string;
}

const { lang = 'fr', type = 'note', title } = Astro.props;

const titles: Record<string, string> = {
  tip: t(lang, 'callout.tip'),
  warning: t(lang, 'callout.warning'),
  note: t(lang, 'callout.note'),
};
const borderColor: Record<string, string> = {
  tip: 'border-primary',
  warning: 'border-warning',
  note: 'border-border-strong',
};
const bgColor: Record<string, string> = {
  tip: 'bg-primary-soft',
  warning: 'bg-warning-soft',
  note: 'bg-surface-2',
};

---

<div class="flex gap-3 rounded-md p-4 border-l-3 {borderColor[type]} {bgColor[type]}">
  <div class="shrink-0">
    {type === 'tip' ? (
      <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    ) : type === 'warning' ? (
      <svg class="w-5 h-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    ) : (
      <svg class="w-5 h-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    )}
  </div>
  <div>
    <h3 class="font-sans font-semibold text-text">{title ?? titles[type]}</h3>
    <slot />
  </div>
</div>